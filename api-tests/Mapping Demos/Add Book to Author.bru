meta {
  name: Add Book to Author
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/demo/mappings/authors/2/books/1
  body: none
  auth: none
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Book was added to Author", function() {
    const data = res.getBody();
    expect(data.books).to.be.an('array');
    // Check if the book with id 1 (Harry Potter) is now in the list of the second author
    expect(data.books.some(b => b.id === 1)).to.be.true;
  });
}
