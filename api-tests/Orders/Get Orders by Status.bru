meta {
  name: Get Orders by Status
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/orders/status/PENDING
  auth: none
}

docs {
  Valid status values: PENDING, CONFIRMED, SHIPPED, DELIVERED, CANCELLED, REFUNDED
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });
}
