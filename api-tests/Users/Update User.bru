    "lastName": "Doe",
    "address": "456 Oak Ave",
    "city": "Springfield",
    "state": "IL",
    "zipCode": "62702",
    "phoneNumber": "555-9876"
  }
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });
